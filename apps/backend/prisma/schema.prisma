generator client {
  provider = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder", "postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  conversations Conversation[]
}

enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Agent：协作定稿字段 creatorId→ownerId、AgentPluginBinding.enabled Boolean
model Agent {
  id                     String      @id @default(cuid())
  workspaceId            String?
  ownerId                String
  name                   String
  description            String?
  avatarUrl              String?
  systemPrompt           String
  model                  String      @default("deepseek-ai/DeepSeek-V4.1-Flash")
  temperature            Float       @default(0.7)
  maxTokens              Int         @default(4096)
  contextLimit           Int         @default(20)
  openingMessage         String?
  status                 AgentStatus @default(DRAFT)
  currentVersionId       String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  versions              AgentVersion[]               @relation("AgentVersions")
  pluginBindings        AgentPluginBinding[]
  knowledgeBaseBindings KnowledgeBaseAgentBinding[]
  workflowBindings      AgentWorkflow[]

  @@index([workspaceId])
  @@index([status])
}

model AgentVersion {
  id        String   @id @default(cuid())
  agentId   String
  version   Int
  snapshot  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation("AgentVersions", fields: [agentId], references: [id])

  @@unique([agentId, version])
  @@index([agentId])
}

/// AgentPluginBinding：enabled Boolean，替代旧表 status 枚举
model AgentPluginBinding {
  id         String  @id @default(cuid())
  agentId    String
  pluginId   String
  enabled    Boolean @default(true)
  autoInvoke Boolean @default(true)
  sortOrder  Int     @default(0)
  config     Json?

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, pluginId])
  @@index([agentId, enabled])
}

model KnowledgeBaseAgentBinding {
  id              String  @id @default(cuid())
  agentId         String
  knowledgeBaseId String
  enabled         Boolean @default(true)
  config          Json?

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, knowledgeBaseId])
}

model AgentWorkflow {
  id         String  @id @default(cuid())
  agentId    String
  workflowId String
  enabled    Boolean @default(true)
  sortOrder  Int     @default(0)

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, workflowId])
}
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  agentId   String?
  title     String   @default("新对话")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  role           String
  status         String
  seq            Int
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, seq])
}
