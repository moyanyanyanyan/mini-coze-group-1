generator client {
  provider = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder", "postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?                    // ← 可空：Google 用户没有密码
  googleId     String?  @unique           // ← Google 账号的 sub，一个 Google 账号最多绑一个用户
  displayName  String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  conversations  Conversation[]
  apiKeys        ApiKey[]
  modelProviders ModelProvider[]
  modelConfigs   ModelConfig[]
}

enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Agent：协作定稿字段 creatorId→ownerId、AgentPluginBinding.enabled Boolean
model Agent {
  id                     String      @id @default(cuid())
  workspaceId            String?
  ownerId                String
  name                   String
  description            String?
  avatarUrl              String?
  systemPrompt           String
  model                  String      @default("deepseek-ai/DeepSeek-V4.1-Flash")
  /// 绑定的模型配置；运行时由模型管理统一解析地址与凭据
  modelConfigId          String?
  temperature            Float       @default(0.7)
  maxTokens              Int         @default(4096)
  contextLimit           Int         @default(20)
  openingMessage         String?
  status                 AgentStatus @default(DRAFT)
  currentVersionId       String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  versions              AgentVersion[]               @relation("AgentVersions")
  pluginBindings        AgentPluginBinding[]
  knowledgeBaseBindings KnowledgeBaseAgentBinding[]
  workflowBindings      AgentWorkflow[]
  apiKeys               ApiKey[]
  modelConfig           ModelConfig? @relation(fields: [modelConfigId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
  @@index([modelConfigId])
}

enum ModelType {
  CHAT
  EMBEDDING
}

/// 模型服务商：名称、协议与默认调用地址。
model ModelProvider {
  id             String   @id @default(cuid())
  ownerId        String   @db.Uuid
  name           String
  /// 首期统一使用 OpenAI 兼容 Chat Completions 协议
  protocol       String   @default("openai_compatible")
  defaultBaseUrl String
  /// 内置服务商标识（deepseek / bailian / siliconflow / custom），便于幂等初始化
  builtinKey     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  configs ModelConfig[]

  @@unique([ownerId, name])
  @@unique([ownerId, builtinKey])
  @@index([ownerId])
}

/// 模型配置：一张连接卡片。API Key 加密入库，接口只返回前 4 位。
model ModelConfig {
  id              String    @id @default(cuid())
  ownerId         String    @db.Uuid
  providerId      String
  name            String
  modelIdentifier String
  type            ModelType @default(CHAT)
  /// 向量模型维度，对话模型为空
  dimension       Int?
  /// 独立调用地址；为空时继承服务商默认地址
  baseUrl         String?
  apiKeyCipher    String
  /// 明文前 4 位，仅用于脱敏展示
  keyPrefix       String
  enabled         Boolean   @default(true)

  /// 内部连通性测试结果（不作为启停依据）
  lastTestedAt    DateTime?
  lastTestStatus  String?
  lastTestLatencyMs Int?
  lastTestErrorType String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner    User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider ModelProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  agents   Agent[]

  @@unique([ownerId, name])
  @@index([ownerId, type, enabled])
  @@index([providerId])
}

model ApiKey {
  id          String    @id @default(cuid())
  agentId     String
  createdById String    @db.Uuid
  name        String
  keyPrefix   String
  keyHash     String    @unique
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  agent     Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById, revokedAt, createdAt])
  @@index([agentId, revokedAt])
}

model AgentVersion {
  id        String   @id @default(cuid())
  agentId   String
  version   Int
  snapshot  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation("AgentVersions", fields: [agentId], references: [id])

  @@unique([agentId, version])
  @@index([agentId])
}

/// AgentPluginBinding：enabled Boolean，替代旧表 status 枚举
model AgentPluginBinding {
  id         String  @id @default(cuid())
  agentId    String
  pluginId   String
  enabled    Boolean @default(true)
  autoInvoke Boolean @default(true)
  sortOrder  Int     @default(0)
  config     Json?

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, pluginId])
  @@index([agentId, enabled])
}

model KnowledgeBaseAgentBinding {
  id              String  @id @default(cuid())
  agentId         String
  knowledgeBaseId String
  enabled         Boolean @default(true)
  config          Json?

  agent Agent @relation(fields: [agentId], references: [id])

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
  @@unique([agentId, knowledgeBaseId])
}

model AgentWorkflow {
  id         String  @id @default(cuid())
  agentId    String
  workflowId String
  enabled    Boolean @default(true)
  sortOrder  Int     @default(0)

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, workflowId])
}
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  agentId   String?
  title     String   @default("新对话")
  contextSummary String?
  contextSummaryThrough String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  operationRuns OperationRuntimeRun[]

  attachments MessageAttachment[]

  @@index([userId, updatedAt])
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  role           String
  status         String
  seq            Int
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversationId, seq])
}

/// 插件目录表。
///
/// - 内置插件由代码中的统一注册表在启动时 upsert 进表，
///   目录元数据以此处为准；执行器仍走对应的内置代码类。
/// - 用户自定义插件（kind = http / mcp）由 POST /api/plugins 写入，
///   http 由 HttpExecutor 按 endpoint 转发，mcp 由 McpExecutor 经 JSON-RPC 调用。
model Plugin {
  id           Int      @id @default(autoincrement())
  /// 全局唯一插件 ID，形如 plugin_echo / plugin_weather
  pluginId     String   @unique
  title        String
  content      String   @default("")
  icon         String?
  /// string[]
  tags         Json     @default("[]")
  /// 插件级配置 Schema（JSON Schema）
  configSchema Json     @default("{}")
  /// PluginToolDefinition[]，与目录同源
  tools        Json
  /// builtin | http | mcp
  kind         String   @default("builtin")
  /// kind = http/mcp 时必填，工具执行时请求该地址
  endpoint     String?
  /// none | bearer | api_key；MCP/HTTP 插件访问远端服务时的鉴权方式
  authType     String   @default("none")
  /// 鉴权凭证（bearer token 或 api key），none 时为空；阶段项目明文存库
  authCredential String?
  /// unknown | connected | error，最近一次握手/连接状态
  connectionStatus String @default("unknown")
  /// 最近一次连接失败原因，成功后清空
  lastError    String?
  /// 运行时是否可用；false 时不进入目录与允许列表
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("plugins")
}
