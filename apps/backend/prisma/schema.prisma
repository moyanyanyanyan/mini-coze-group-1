//Prisma schema:数据库的‘表结构图纸’
//这个文件是全组公共资产

generator client{
    provider="prisma-client-js"
}

datasource db {
    provider="postgresql"
    url     =env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}