generator client {
  provider = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder", "postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Agent：协作定稿字段 creatorId→ownerId、AgentPluginBinding.enabled Boolean
model Agent {
  id                     String      @id @default(cuid())
  workspaceId            String?
  ownerId                String
  name                   String
  description            String?
  avatarUrl              String?
  systemPrompt           String
  model                  String      @default("deepseek-chat")
  temperature            Float       @default(0.7)
  maxTokens              Int         @default(4096)
  contextLimit           Int         @default(20)
  openingMessage         String?
  status                 AgentStatus @default(DRAFT)
  currentVersionId       String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  versions              AgentVersion[]               @relation("AgentVersions")
  pluginBindings        AgentPluginBinding[]
  knowledgeBaseBindings KnowledgeBaseAgentBinding[]
  workflowBindings      AgentWorkflow[]

  @@index([workspaceId])
  @@index([status])
}

model AgentVersion {
  id        String   @id @default(cuid())
  agentId   String
  version   Int
  snapshot  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation("AgentVersions", fields: [agentId], references: [id])

  @@unique([agentId, version])
  @@index([agentId])
}

/// AgentPluginBinding：enabled Boolean，替代旧表 status 枚举
model AgentPluginBinding {
  id         String  @id @default(cuid())
  agentId    String
  pluginId   String
  enabled    Boolean @default(true)
  autoInvoke Boolean @default(true)
  sortOrder  Int     @default(0)
  config     Json?

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, pluginId])
  @@index([agentId, enabled])
}

model KnowledgeBaseAgentBinding {
  id              String  @id @default(cuid())
  agentId         String
  knowledgeBaseId String
  enabled         Boolean @default(true)
  config          Json?

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, knowledgeBaseId])
}

model AgentWorkflow {
  id         String  @id @default(cuid())
  agentId    String
  workflowId String
  enabled    Boolean @default(true)
  sortOrder  Int     @default(0)

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, workflowId])
}

/// 插件目录表。
///
/// - 内置插件（plugin_echo / plugin_time）由代码在启动时 upsert 进表，
///   目录元数据以此处为准；执行器仍走代码里的 EchoExecutor / TimeExecutor。
/// - 用户自定义插件（kind = http）由 POST /api/plugins 写入，
///   执行时由 HttpExecutor 按 endpoint 转发请求。
model Plugin {
  id           Int      @id @default(autoincrement())
  /// 全局唯一插件 ID，形如 plugin_echo / plugin_weather
  pluginId     String   @unique
  title        String
  content      String   @default("")
  icon         String?
  /// string[]
  tags         Json     @default("[]")
  /// 插件级配置 Schema（JSON Schema）
  configSchema Json     @default("{}")
  /// PluginToolDefinition[]，与目录同源
  tools        Json
  /// builtin | http
  kind         String   @default("builtin")
  /// kind = http 时必填，工具执行时 POST 到该地址
  endpoint     String?
  /// 运行时是否可用；false 时不进入目录与允许列表
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("plugins")
}
