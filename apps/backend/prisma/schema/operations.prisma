/// 只记录 Runtime 客户端可观测事实，不替代聊天业务终态。
model OperationRuntimeRun {
  id                 String   @id @db.Uuid
  userId             String   @db.Uuid
  agentId            String
  conversationId     String   @db.Uuid
  assistantMessageId String   @db.Uuid
  mode               String
  model              String
  status             String   @default("running")
  startedAt          DateTime @default(now())
  finishedAt         DateTime?
  durationMs         Int?
  firstTokenMs       Int?
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  errorCode          String?
  events             Json     @default("[]")
  truncated          Boolean  @default(false)
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt, id])
  @@index([userId, conversationId, startedAt])
}
