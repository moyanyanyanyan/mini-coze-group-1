/// 只记录 Runtime 客户端可观测事实，不替代聊天业务终态。
model OperationRuntimeRun {
  id                 String   @id @db.Uuid
  userId             String   @db.Uuid
  agentId            String
  conversationId     String   @db.Uuid
  assistantMessageId String   @db.Uuid
  mode               String
  source             String   @default("unknown")
  apiKeyId           String?
  model              String
  status             String   @default("running")
  startedAt          DateTime @default(now())
  finishedAt         DateTime?
  durationMs         Int?
  firstTokenMs       Int?
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  errorCode          String?
  events             Json     @default("[]")
  truncated          Boolean  @default(false)
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt, id])
  @@index([userId, conversationId, startedAt])
}

model OperationTelemetry {
  id              String   @id @default(uuid()) @db.Uuid
  ownerId         String?
  kind            String
  status          String
  knowledgeBaseId String?
  documentId      String?
  agentId         String?
  runId           String?
  apiKeyId        String?
  startedAt       DateTime @default(now())
  durationMs      Int
  inputTokens     Int?
  itemCount       Int     @default(0)
  data            Json    @default("{}")

  @@index([ownerId, kind, startedAt])
  @@index([ownerId, knowledgeBaseId, startedAt])
  @@index([ownerId, runId])
}

/// 由 Operations 数据库触发器记录，不在知识库业务服务中重复写入。
model OperationDocumentAttempt {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId   String
  ordinal      Int
  source       String
  status       String
  stage        String
  startedAt    DateTime?
  finishedAt   DateTime?
  capturedAt   DateTime @default(now())
  errorCode    String?
  errorMessage String?
  events       Json @default("[]")
  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
}
