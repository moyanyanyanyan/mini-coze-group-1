# PostgreSQL / pgvector
POSTGRES_DB=minicoze
POSTGRES_USER=minicoze
POSTGRES_PASSWORD=minicoze
DATABASE_URL=postgresql://minicoze:minicoze@localhost:5432/minicoze

# Web
VITE_API_BASE_URL=http://localhost:3000/api

# Backend
PORT=3000
WEB_ORIGIN=http://localhost:5173
AGENT_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=dev-internal-token

# JWT
JWT_SECRET=请填至少32位的随机字符串
JWT_EXPIRES_IN=7d  # 7d=7天

# Google OAuth（留空 = 自动走 Mock Provider，本地无外网也能演示）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# true = 强制 Mock（跑测试 / 演示用）；不填 = 有凭据走真 Google，无凭据走 Mock
AUTH_GOOGLE_MOCK=

# Agent
AGENT_PORT=8000
BACKEND_ORIGIN=http://localhost:3000

