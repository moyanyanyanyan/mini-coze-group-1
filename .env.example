# PostgreSQL / pgvector
POSTGRES_DB=minicoze
POSTGRES_USER=minicoze
POSTGRES_PASSWORD=minicoze
DATABASE_URL=postgresql://minicoze:minicoze@localhost:5432/minicoze

# Web
VITE_API_BASE_URL=http://localhost:3000/api

# Backend
PORT=3000
WEB_ORIGIN=http://localhost:5173
AGENT_SERVICE_URL=http://localhost:8000

# Agent
AGENT_PORT=8000
BACKEND_ORIGIN=http://localhost:3000
INTERNAL_SERVICE_TOKEN=
DEEPSEEK_API_KEY=
# 变量名沿用现有模型调用契约，以下示例通过硅基流动调用DeepSeek模型
# deepseek / siliconflow / openai_compatible
MODEL_PROVIDER=siliconflow
MODEL_TRUST_ENV=true
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3.2
# 可选的额外模型允许列表，逗号分隔；不会自动替换 AgentConfig.model
DEEPSEEK_ALLOWED_MODELS=
MODEL_TIMEOUT_SECONDS=60
RUN_TIMEOUT_SECONDS=180
CONTEXT_TOKEN_LIMIT=32768
BACKEND_SERVICE_URL=http://localhost:3000
PLUGINS_SERVICE_TOKEN=
PROVIDER_TIMEOUT_SECONDS=15

